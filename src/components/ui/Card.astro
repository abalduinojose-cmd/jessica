---
interface Props {
  class?: string;
  style?: string;
}

const { class: className, style } = Astro.props;
---

<article
  class:list={[
    'rounded-3xl bg-cream p-6 shadow-softer ring-1 ring-copper/10 transition-shadow duration-300 hover:shadow-soft sm:p-8',
    className,
  ]}
  style={style}
>
  <slot />
</article>
