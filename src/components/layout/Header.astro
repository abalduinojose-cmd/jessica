---
import { Image } from 'astro:assets';
import logoMark from '../../assets/logo/jg-mark.png';
import { SITE, CONTACT, NAV_LINKS } from '../../config/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-copper/10 bg-blush/70 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:h-20">
    <a href="#inicio" class="flex items-center gap-3" aria-label={`${SITE.name}, voltar ao início`}>
      <Image
        src={logoMark}
        alt=""
        widths={[120, 240]}
        sizes="88px"
        quality={90}
        loading="eager"
        class="h-11 w-auto"
      />
      <span class="hidden flex-col leading-tight sm:flex">
        <span class="font-display text-lg font-semibold tracking-tight text-ink">{SITE.name}</span>
        <span class="text-[0.65rem] font-semibold tracking-[0.3em] text-copper-dark uppercase">
          Banho e Tosa
        </span>
      </span>
    </a>

    <nav class="hidden lg:block" aria-label="Navegação principal">
      <ul class="flex items-center gap-7 text-sm font-medium text-ink/80">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a class="transition-colors hover:text-copper-dark" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <Button
        href={CONTACT.whatsappUrl}
        size="sm"
        external
        whatsapp
        analytics="header"
        class="hidden sm:inline-flex"
      >
        <Icon name="whatsapp" class="h-4 w-4" />
        Agendar
      </Button>

      {/* Menu mobile 100% CSS com <details>/<summary> — zero JS */}
      <details class="group relative lg:hidden">
        <summary
          class="grid h-11 w-11 cursor-pointer list-none place-items-center rounded-full border border-copper/25 bg-cream/70 text-copper-dark [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menu de navegação"
        >
          <span class="group-open:hidden"><Icon name="menu" class="h-5 w-5" /></span>
          <span class="hidden group-open:block"><Icon name="close" class="h-5 w-5" /></span>
        </summary>
        <nav
          class="absolute right-0 mt-3 w-64 rounded-3xl border border-copper/15 bg-cream p-4 shadow-soft"
          aria-label="Navegação móvel"
        >
          <ul class="flex flex-col gap-1 text-sm font-medium text-ink/85">
            {
              NAV_LINKS.map((link) => (
                <li>
                  <a
                    class="block rounded-xl px-4 py-2.5 transition-colors hover:bg-blush/60 hover:text-copper-dark"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li class="mt-2 border-t border-copper/15 pt-3">
              <Button
                href={CONTACT.whatsappUrl}
                size="sm"
                external
                whatsapp
                analytics="menu-mobile"
                class="w-full"
              >
                <Icon name="whatsapp" class="h-4 w-4" />
                Agendar no WhatsApp
              </Button>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
