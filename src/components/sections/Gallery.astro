---
import { Image, getImage } from 'astro:assets';
import { galleryItems } from '../../data/gallery';
import SectionTitle from '../ui/SectionTitle.astro';

/* Gera a versão ampliada (lightbox) de cada foto em WebP */
const items = await Promise.all(
  galleryItems.map(async (item) => ({
    ...item,
    full: (await getImage({ src: item.image, width: 1200, format: 'webp', quality: 82 })).src,
  }))
);
---

<section id="galeria" class="bg-cream py-24 lg:py-32">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionTitle
      eyebrow="Galeria"
      title="Trabalhos que falam por si"
      subtitle="Alguns dos pets que já passaram pelas minhas mãos, cada um com o seu estilo."
    />

    <div class="mt-14 columns-2 gap-4 md:columns-3 md:gap-5">
      {
        items.map((item) => (
          <button
            type="button"
            class="lightbox-trigger group mb-4 block w-full cursor-zoom-in break-inside-avoid overflow-hidden rounded-3xl shadow-softer transition-shadow hover:shadow-soft md:mb-5"
            data-src={item.full}
            data-alt={item.alt}
            aria-label={`Ampliar foto: ${item.alt}`}
          >
            <Image
              src={item.image}
              alt={item.alt}
              widths={[400, 800]}
              sizes="(min-width: 768px) 30vw, 45vw"
              quality={80}
              loading="lazy"
              class="w-full transition-transform duration-500 group-hover:scale-[1.03]"
            />
          </button>
        ))
      }
    </div>

    <p class="reveal mt-8 text-center text-sm text-ink/60">
      Quer ver mais transformações? Acompanhe no Instagram.
    </p>
  </div>

  {/* Lightbox com <dialog> nativo */}
  <dialog
    id="lightbox"
    class="m-auto w-[min(92vw,40rem)] rounded-3xl bg-cream p-3 shadow-soft backdrop:bg-ink/70 backdrop:backdrop-blur-sm"
  >
    <img id="lightbox-img" src="" alt="" class="w-full rounded-2xl" loading="lazy" decoding="async" />
    <form method="dialog" class="mt-3 text-center">
      <button
        class="rounded-full border border-copper/30 px-6 py-2 text-sm font-semibold text-copper-dark transition-colors hover:bg-blush/50"
      >
        Fechar
      </button>
    </form>
  </dialog>

  {/*
    JS inevitável (~0,4 KB): o <dialog> nativo precisa de showModal()/close()
    por script — não há API declarativa para abrir modal em HTML puro.
  */}
  <script is:inline>
    (function () {
      var dialog = document.getElementById('lightbox');
      var img = document.getElementById('lightbox-img');
      if (!dialog || !img) return;

      document.querySelectorAll('.lightbox-trigger').forEach(function (btn) {
        btn.addEventListener('click', function () {
          img.src = btn.dataset.src;
          img.alt = btn.dataset.alt;
          dialog.showModal();
        });
      });

      dialog.addEventListener('click', function (event) {
        if (event.target === dialog) dialog.close();
      });
    })();
  </script>
</section>
