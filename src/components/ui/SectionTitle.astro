---
import Divider from './Divider.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, subtitle, align = 'center', class: className } = Astro.props;
const centered = align === 'center';
---

<div class:list={['reveal max-w-2xl', centered && 'mx-auto text-center', className]}>
  {
    eyebrow && (
      <p class="mb-3 text-xs font-bold tracking-[0.3em] text-copper-dark uppercase">{eyebrow}</p>
    )
  }
  <h2 class="font-display text-[clamp(1.9rem,1.4rem+2vw,3rem)] leading-tight font-semibold tracking-tight text-ink">
    {title}
  </h2>
  {subtitle && <p class="mt-4 leading-relaxed text-ink/70">{subtitle}</p>}
  <Divider center={centered} class="mt-6" />
</div>
